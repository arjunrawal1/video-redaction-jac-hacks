# Copy to .env and fill in. Jac loads .env automatically.

# Vertex AI (Gemini) - service account JSON with the Vertex AI User role
GOOGLE_APPLICATION_CREDENTIALS=./vertex-key.json
VERTEXAI_PROJECT=your-gcp-project-id
VERTEXAI_LOCATION=us-central1

# Optional model override
REDACTION_MODEL=vertex_ai/gemini-2.5-flash

# AWS Textract, for word-level OCR geometry
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
